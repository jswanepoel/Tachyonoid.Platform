<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Tachyonoid.BuildingBlocks.Persistence</RootNamespace>
    <AssemblyName>Tachyonoid.BuildingBlocks.Persistence</AssemblyName>
    <Description>Common persistence: EF Core interceptors, value converters, specification evaluator. Per ADR-019: references Domain ONLY.</Description>
    <PackageTags>hermes;buildingblocks;persistence;efcore</PackageTags>
    <IsPackable>true</IsPackable>
    <NoWarn>NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tachyonoid.BuildingBlocks.Domain\Tachyonoid.BuildingBlocks.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0-*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0-*" />
  </ItemGroup>

</Project>
